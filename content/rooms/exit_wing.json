      ],
      "name": "DEBUG.DEB",
      "npcId": "deb",
      "avatar": "windup",
      "color": "#7fd8e8",
      "dialogAsk": "Attempt number one. That's what this is. Nobody's ever been THIS far — so whatever happens next, the count starts with YOU. Run before the rattle."
